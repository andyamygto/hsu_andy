#!/usr/bin/env bash
# 開一篇新的筆記或文章，並用 vim 打開。
#   bin/new note gw-plasmon-pole "GW plasmon-pole 模型"
#   bin/new post 2026-first-post "第一篇"
# 資料夾名稱（第二個參數）會變成網址，用英文小寫和 - 。
set -euo pipefail

kind=${1:-}; slug=${2:-}; title=${3:-${2:-}}
case "$kind" in
  note) dir="content/notes/$slug" ;;
  post) dir="content/posts/$slug" ;;
  *) echo "用法: bin/new note|post 資料夾名稱 [\"標題\"]"; exit 1 ;;
esac
[ -n "$slug" ] || { echo "缺少資料夾名稱"; exit 1; }

cd "$(dirname "$0")/.."
file="$dir/index.md"
if [ ! -e "$file" ]; then
  mkdir -p "$dir"
  {
    echo "---"
    echo "title: \"$title\""
    echo "date: $(date +%Y-%m-%d)"
    [ "$kind" = note ] && echo 'topic: ""'
    echo "tags: []"
    echo "draft: true"
    echo "---"
    echo
    echo "<!-- 區塊: def 定義 / result 結果 / derive 推導 / param 參數 / warn 注意 / idea 想法 / todo 待辦 / ref 參考"
    echo "     寫成 > [!def] 標題 ，下一行起每行開頭都是 > 。 [!derive]- 會預設收合。 -->"
    echo
  } > "$file"
  echo "建立 $file"
fi
exec "${EDITOR:-vim}" "$file"
