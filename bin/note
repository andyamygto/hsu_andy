#!/usr/bin/env bash
# note — 寫筆記、上線，全部用這一個指令。直接打 `note` 看說明。
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"
EDITOR="${EDITOR:-vim}"

usage() {
  cat <<'EOF'
note new  名稱 ["標題"]     開一篇新筆記（草稿，只在這台電腦）
note post 名稱 ["標題"]     開一篇新文章（草稿）
note edit 名稱              打開草稿或已公開的筆記（名稱打一部分就好）
note add  名稱 檔案...      把圖片、PDF 複製進那篇的資料夾
note list                   列出草稿和已公開的
note preview                本機預覽 http://localhost:1313/hsu_andy/ （含草稿）
note publish 名稱           草稿上線：移進網站、commit、push
note push ["說明"]          已公開的筆記改完後，commit + push

名稱會變成網址，用英文小寫和 - ，例如 gw-plasmon-pole。
草稿放在 drafts/，不會上傳到 GitHub。
EOF
}

die() { echo "note: $*" >&2; exit 1; }

# 找出名稱對應的資料夾：先找完全相同，再找包含這段字的
find_dir() {
  local q="$1" hits
  hits=$(find drafts content -mindepth 2 -maxdepth 2 -type d \( -path '*/notes/*' -o -path '*/posts/*' \) 2>/dev/null | sort)
  local exact; exact=$(grep -E "/$q\$" <<<"$hits" || true)
  [ -n "$exact" ] && { head -1 <<<"$exact"; return; }
  local some; some=$(grep -F -- "$q" <<<"$hits" || true)
  [ -z "$some" ] && die "找不到「$q」。用 note list 看有哪些。"
  [ "$(wc -l <<<"$some")" -gt 1 ] && die "「$q」對到好幾篇，打完整一點：
$some"
  echo "$some"
}

create() {
  local kind="$1" name="${2:-}" title="${3:-${2:-}}"
  [ -n "$name" ] || die "要給名稱，例如 note new gw-plasmon-pole"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "名稱只用英文小寫、數字和 - ：$name"
  [ -e "content/$kind/$name" ] && die "已經有公開的 content/$kind/$name ，用 note edit $name"
  local dir="drafts/$kind/$name"
  if [ ! -e "$dir/index.md" ]; then
    mkdir -p "$dir"
    {
      echo "---"
      echo "title: \"$title\""
      echo "date: $(date +%Y-%m-%d)"
      [ "$kind" = notes ] && echo 'topic: ""'
      echo "tags: []"
      echo "---"
      echo
      echo "<!-- 區塊: def 定義 / result 結果 / derive 推導 / param 參數 / warn 注意 / idea 想法 / todo 待辦 / ref 參考"
      echo "     > [!def] 標題  ，之後每行開頭都是 > 。 [!derive]- 會預設收合。 -->"
      echo
    } > "$dir/index.md"
    echo "草稿：$dir/"
  fi
  exec "$EDITOR" "$dir/index.md"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  new)  create notes "$@" ;;
  post) create posts "$@" ;;

  edit)
    [ -n "${1:-}" ] || die "要給名稱"
    exec "$EDITOR" "$(find_dir "$1")/index.md" ;;

  add)
    [ $# -ge 2 ] || die "用法：note add 名稱 檔案..."
    dir=$(find_dir "$1"); shift
    cp -v -- "$@" "$dir/"
    for f in "$@"; do
      b=$(basename -- "$f")
      case "$b" in
        *.png|*.jpg|*.jpeg|*.svg|*.gif|*.webp) echo "  文章裡寫：![說明]($b)" ;;
        *) echo "  文章裡寫：[$b]($b)" ;;
      esac
    done ;;

  list)
    for kind in notes posts; do
      for base in drafts content; do
        for d in "$base/$kind"/*/; do
          [ -f "$d/index.md" ] || continue
          t=$(grep -m1 '^title:' "$d/index.md" | sed 's/^title: *//; s/^"//; s/"$//')
          if [ "$base" = drafts ]; then s="草稿"; elif grep -q '^draft: *true' "$d/index.md"; then s="範例"; else s="公開"; fi
          printf '%s  %-6s %-28s %s\n' "$s" "$kind" "$(basename "$d")" "$t"
        done
      done
    done ;;

  preview)
    command -v hugo >/dev/null || die "沒有安裝 Hugo。Mac：brew install hugo；Linux：見 https://gohugo.io/installation/"
    exec hugo server -D ;;

  publish)
    [ -n "${1:-}" ] || die "要給名稱"
    src=$(find_dir "$1")
    [[ "$src" == drafts/* ]] || die "$src 已經公開了。改完用 note push"
    dest="content/${src#drafts/}"
    grep -q '^topic: *""' "$src/index.md" && echo "提醒：還沒填 topic，會放在 Other。"
    mkdir -p "$(dirname "$dest")"
    mv "$src" "$dest"
    title=$(grep -m1 '^title:' "$dest/index.md" | sed 's/^title: *//; s/^"//; s/"$//')
    git add -- "$dest"
    git commit -q -m "Publish: $title"
    git push -q
    echo "已上線：$dest （約一分鐘後網站更新）" ;;

  push)
    git add -- content data static
    git diff --cached --quiet && die "沒有改動"
    git commit -q -m "${1:-Update notes $(date +%Y-%m-%d)}"
    git push -q
    echo "已推上去（約一分鐘後網站更新）" ;;

  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
